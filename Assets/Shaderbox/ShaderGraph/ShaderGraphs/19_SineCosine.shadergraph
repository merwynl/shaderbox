{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "a6c9a10e9e7341bfb7284fe951a110d9",
    "m_Title": "UV Rotate",
    "m_Content": "Subtracting the UV's by 0.5 in both X & Y so that we're shifting the pivot point to the center. Otherwise we'll be rotating from 0,0. At the very end we're adding it back in. The top section is rotating the U coordinates while the bottom is rotating the V coords.                                         U Rotate = Takes Cos & multiplies by R/U & Multiplies Sin by G/V then Adds                                           V Rotate = Takes Cos & multiplies by G/V & multiplies Sin by R/U then Subtracts",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -4247.0,
        "y": 4966.0,
        "width": 479.0,
        "height": 102.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

