{
    "m_SGVersion": 0,
    "m_Type": "UnityEditor.ShaderGraph.StickyNoteData",
    "m_ObjectId": "cda891a1acae4440bde425c82233bac7",
    "m_Title": "Ripple Effect Breakdown",
    "m_Content": "Time > Fraction > Subtract > Add. When added to a texture or circle gradient, it creates a cycling effect as if the circle is expanding and getting larger. Multipying after that to sharpen the edges of the mask. Then clamping the values between a certain range to avoid clipping. Max value should not exceed the previous multiplication threshold.  We multiply by Pi to further crispen the effect then adding in a Sine node in order to simulate a wave like ripple effect.",
    "m_TextSize": 0,
    "m_Theme": 0,
    "m_Position": {
        "serializedVersion": "2",
        "x": -4031.0,
        "y": 2402.0,
        "width": 479.0,
        "height": 121.0
    },
    "m_Group": {
        "m_Id": ""
    }
}

